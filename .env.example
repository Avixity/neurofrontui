# Public project values. These are compiled into the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after configuring the Google provider in Supabase Auth.
VITE_GOOGLE_AUTH_ENABLED=false

# Server-only. Never prefix any of these values with VITE_.
# SUPABASE_SECRET_KEY accepts the current Supabase secret key.
# SUPABASE_SERVICE_ROLE_KEY is also accepted for a legacy service-role key.
SUPABASE_SECRET_KEY=
AI_GATEWAY_API_KEY=
# Choose a current text model ID from the AI Gateway model catalog.
ASSISTANT_MODEL=
# Generate at least 32 random characters; do not use an example value.
ASSISTANT_SIGNING_SECRET=
APP_ORIGIN=http://localhost:5180
