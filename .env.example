# Server environment only. Never put real values in browser JavaScript or Git.
GROQ_API_KEY=
# Production model documented by Groq. Check its availability in your account.
GROQ_MODEL=openai/gpt-oss-20b
# Independent input/output review model; verify account access to this model too.
GROQ_REVIEW_MODEL=openai/gpt-oss-120b

# Option A: shared, atomic rate limits across function instances and regions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Option B: set vercel ONLY after enforcing the production/preview Firewall rule
# POST /api/assistant, 12 requests per minute per IP. WAF limits are per region.
ASSISTANT_RATE_BACKEND=
# Generate a random value with at least 32 characters. Used to hash IP rate keys.
ASSISTANT_RATE_SALT=

# Local preview only. node --env-file=.env.local local-server.cjs
PORT=5180
